# --- LLM backend (auto-detected; Ollama tried first) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Fallback / override (any OpenAI-compatible endpoint)
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- Self-improvement ---
JARVIS_FULL_CONTROL=0          # 1 = auto-merge after tests pass (still asks once per session)
JARVIS_REPO_PATH=.             # repo Jarvis is allowed to modify

# --- Voice ---
JARVIS_VOICE=0                 # 1 = enable voice on startup
JARVIS_WAKEWORD=hey_jarvis
JARVIS_PIPER_VOICE=en_US-amy-medium

# --- Memory ---
JARVIS_DATA_DIR=./data
